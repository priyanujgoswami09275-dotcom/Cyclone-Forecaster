# Mobile app environment. Copy to `mobile/.env` and fill in.
#
#   cp .env.example .env
#
# `mobile/.env` is gitignored (.gitignore ignores `.env` at any depth and
# re-includes only `.env.example`). Never commit a real value.
#
# This file has to live HERE rather than in the repo root: Expo loads `.env`
# from the directory containing app.json, which is `mobile/`. A
# root-level `.env` is invisible to the app bundler.

# --- required ---------------------------------------------------------------

# The backend origin the phone fetches from. Must be the Mac's LAN IP on the
# same Wi-Fi, NOT localhost: on a device, localhost is the device itself, and
# the app will report a network error that looks like a dead backend.
#
#   http://192.168.1.20:8000        <- the usual shape
#
# No trailing slash, no path. Expo inlines EXPO_PUBLIC_* into the JS bundle at
# build time, so restart the bundler (`npx expo start -c`) after changing it —
# a hot reload is not enough, and the old value will keep being used.
EXPO_PUBLIC_API_URL=

# --- optional ---------------------------------------------------------------

# Only needed for a standalone Android build (`eas build`), which has no Expo
# Go to borrow a maps key from. react-native-maps uses the **Google Maps SDK**
# on Android, and without an authorised key it renders a blank grey tile grid
# rather than an error. Leave empty for `npx expo start` in Expo Go.
#
# Read by mobile/app.config.ts, which is why it can be a secret: it is
# injected into the native config at build time and never lands in app.json.
GOOGLE_MAPS_ANDROID_API_KEY=
