{
  "expo": {
    "name": "Cyclone Forecaster",
    "slug": "cyclone-forecaster",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cycloneforecaster",
    "userInterfaceStyle": "light",
