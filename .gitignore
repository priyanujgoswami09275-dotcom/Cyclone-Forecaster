venv/
__pycache__/
*.pyc
.DS_Store
.superpowers/

# Secrets. GEMINI_API_KEY lives here (see .env.example); Rules.md says it must
# never reach a tracked file. `.env.example` IS committed and holds no secret.
.env
.env.*
!.env.example

# node / expo
node_modules/
.expo/
*.tsbuildinfo

# Tooling state at the repo root, not app dependencies. The Expo app's own
# manifests are `mobile/package.json` and `mobile/package-lock.json` and are
# tracked; these root ones belong to the Claude Code CLI install and the
# skills installer, which follow the cwd they were launched from.
#
# The leading slash is load-bearing. A bare `package.json` matches at ANY
# depth and would also match mobile/package.json, which is committed and
# load-bearing. Anchored to the root, these cannot reach it.
/.claude/
/package.json
/package-lock.json
/skills-lock.json

# data-fetch artifacts are only committed when they live under data/
*.geojson
*.tif
*.pkl
!data/*.geojson
!data/*.tif
!data/*.pkl

# one-off scratch: GEE export archives and ad-hoc probe scripts kept at the
# repo root during the DEM fetch. The DEM they produced IS committed
# (data/dem.tif); these are the raw downloads and a scratch query, not sources.
dem_archive.zip
project.zip
/fetch_dem.py
/test_gee.py

.vercel

